# ============================================================
# RuralFlow - Environment Configuration Template
# Copy this file to .env and configure your local settings
# NEVER commit real credentials, passwords, or secrets to Git
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruralflow_db?schema=public"
