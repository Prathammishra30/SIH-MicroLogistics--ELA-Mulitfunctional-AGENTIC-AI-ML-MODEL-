# ============================================================
# RuralFlow - Environment Configuration Template
# Copy this file to .env and configure your local settings
# NEVER commit real credentials, passwords, or secrets to Git
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# JWT Authentication Secret
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruralflow_db?schema=public"

# Google Gemini API Key for ELA Agentic AI (Optional - falls back to built-in rule provider if unset)
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.0-flash

